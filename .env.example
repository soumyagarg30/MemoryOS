# Local development only; use deployment-specific credentials in production.
MEMORYOS_DATABASE_URL=postgresql+psycopg://memoryos:memoryos@localhost:5432/memoryos
MEMORYOS_DEBUG=false
MEMORYOS_SQL_ECHO=false
# Local Ollama server; no API key required.
MEMORYOS_OLLAMA_BASE_URL=http://localhost:11434
MEMORYOS_OLLAMA_TIMEOUT=120
MEMORYOS_CHAT_MODEL=qwen2.5:7b
MEMORYOS_EXTRACTION_MODEL=qwen2.5:7b
MEMORYOS_CONFLICT_MODEL=qwen2.5:7b
MEMORYOS_CONSOLIDATION_MODEL=qwen2.5:7b
MEMORYOS_CONSOLIDATION_SIMILARITY=0.85
MEMORYOS_CONSOLIDATION_MIN_CONFIDENCE=0.8
MEMORYOS_EMBEDDING_MODEL=nomic-embed-text:latest
# Optional for embedding models that support custom dimensions:
# MEMORYOS_EMBEDDING_DIMENSIONS=768
POSTGRES_USER=memoryos
POSTGRES_PASSWORD=memoryos
POSTGRES_DB=memoryos
POSTGRES_PORT=5432
